rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isMember(partyId) {
      return signedIn()
        && exists(/databases/$(database)/documents/parties/$(partyId)/members/$(request.auth.uid));
    }

    function isOwner(partyId) {
      return signedIn()
        && get(/databases/$(database)/documents/parties/$(partyId)).data.ownerUid == request.auth.uid;
    }

    function isOwnerAfter(partyId) {
      return signedIn()
        && getAfter(/databases/$(database)/documents/parties/$(partyId)).data.ownerUid == request.auth.uid;
    }

    function validScore(value) {
      return value is int && value >= 0;
    }

    function canWritePrediction(partyId) {
      return isMember(partyId)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.matchId is string
        && validScore(request.resource.data.homeScore)
        && validScore(request.resource.data.awayScore)
        && get(/databases/$(database)/documents/parties/$(partyId)/matches/$(request.resource.data.matchId)).data.status != "finished";
    }

    match /users/{userId} {
      allow read, create, update: if signedIn() && request.auth.uid == userId;
      allow delete: if false;

      match /parties/{partyId} {
        allow read, create, update, delete: if signedIn() && request.auth.uid == userId;
      }
    }

    match /partyCodes/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && request.resource.data.partyId is string
        && getAfter(/databases/$(database)/documents/parties/$(request.resource.data.partyId)).data.ownerUid == request.auth.uid;
      allow update, delete: if false;
    }

    match /parties/{partyId} {
      allow read: if isMember(partyId) || (signedIn() && memberId == request.auth.uid);      allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow update: if isOwner(partyId)
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.code == resource.data.code;
      allow delete: if isOwner(partyId);

      match /members/{memberId} {
        allow read: if isMember(partyId);
        allow create: if signedIn()
          && memberId == request.auth.uid
          && request.resource.data.uid == request.auth.uid;
        allow update: if isOwner(partyId)
          || (signedIn() && memberId == request.auth.uid && request.resource.data.uid == request.auth.uid);
        allow delete: if isOwner(partyId);
      }

      match /matches/{matchId} {
        allow read: if isMember(partyId);
        allow create: if isOwnerAfter(partyId);
        allow update, delete: if isOwner(partyId);
      }

      match /predictions/{predictionId} {
        allow read: if isMember(partyId);
        allow create, update: if canWritePrediction(partyId);
        allow delete: if signedIn() && resource.data.uid == request.auth.uid;
      }
    }
  }
}
